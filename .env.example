# Use `install -m 600 .env.example .env` and edit. Optional values have defaults; the gateway requires a Telegram allowlist; read by bootstrap.sh and install.sh.

# --- server user / access (bootstrap.sh) ---
VPS_USER=agent                          # Linux user that runs the agents (created if missing)
SSH_PUBKEY=""                           # your public key; empty = copy root's authorized_keys
NODE_MAJOR=22                           # Node.js major version from NodeSource

# --- git identity used by agents ---
GIT_AUTHOR_NAME="Your Name"
GIT_AUTHOR_EMAIL="you@example.com"

# --- Tailscale (optional) ---
TAILSCALE_AUTHKEY=                      # one-off auth key for unattended `tailscale up`; empty = log in manually
TAILSCALE_IP=                           # this node's `tailscale ip -4`, only for SLED_TAILNET_SOCAT
SLED_TAILNET_SOCAT=0                    # 1 = expose Sled on TAILSCALE_IP:8787 via socat instead of tailscale serve

# --- projects / herdr ---
PROJECTS="project-a project-b"          # folders created under ~/projects
HERDR_SESSIONS="project-a:project-a project-b:project-b"  # name:dir-under-~/projects, one herdr session each; empty = none

# --- optional components (1 = install, 0 = skip) ---
WITH_HERMES=1
WITH_CLAUDE=1                           # Claude Code CLI + ~/.claude subagents
WITH_PI=1                               # Pi coding agent
WITH_SLED=1                             # Sled web UI
WITH_HERDR=1                            # herdr terminal sessions
WITH_TAILSCALE=1

# --- Hermes model (all optional; empty = choose later with `hermes model`) ---
# Provider examples (see Hermes docs for the full list): openai-codex (ChatGPT login), openrouter,
# anthropic, gemini, nous, copilot, deepinfra, ollama-cloud, lmstudio, custom (any OpenAI-compatible URL)
HERMES_PROVIDER=
HERMES_MODEL=                           # orchestrator model id offered by that provider
HERMES_SUBAGENT_MODEL=                  # model for delegated subagents; empty = Hermes default
HERMES_BASE_URL=                        # only for custom/self-hosted endpoints, e.g. http://127.0.0.1:11434/v1
HERMES_API_KEY_ENV=                     # NAME of the env var holding the key, e.g. MY_LLM_API_KEY. Put the key itself in ~/.hermes/.env
HERMES_MAX_SUBAGENTS=2                  # parallel subagents; 2 for 8 GB RAM, ~4 for 16 GB
HERMES_PROFILES_DIR=                    # profile source; empty = profiles.local/ if present, else examples/profiles/

# --- Claude Code models (optional; empty = Claude Code defaults) ---
CLAUDE_MODEL=                           # e.g. opus, sonnet or a full model id
CLAUDE_SUBAGENT_MODEL=                  # model for ~/.claude/agents executor/reviewer subagents

# --- Telegram (optional) ---
TELEGRAM_ALLOWED_USERS=                 # explicit allowed numeric user IDs; required before gateway enable
TELEGRAM_USER_ID=                       # your numeric id (@userinfobot); sets the gateway home channel

# --- reviewer profile ---
TRUSTED_AUTHORS=""                      # space-separated exact GitHub logins; empty = static review for all PRs
REVIEW_ORGS=""                          # space-separated GitHub orgs/users whose labeled PRs the reviewer handles

# --- misc ---
# Full commit SHAs; review upstream diffs before bumping (defaults in install-skills.sh).
PSTACK_REF=ae5650febf4320793844c12c4adaa937f417f8da
HERDR_SKILL_REF=ee5bfb5041bb3e4a49d591c72308aae3c81ecdde
