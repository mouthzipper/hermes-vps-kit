# ~/.hermes/.env  (chmod 600, never commit). Created by install.sh; edit afterwards.
# Per-profile overrides go in ~/.hermes/profiles/<name>/.env
# Model credentials: subscription providers log in via `hermes model` (no key here).
# API-key providers: add the provider's variable (see Hermes docs), or the variable named in HERMES_API_KEY_ENV.
# Telegram gateway: token from @BotFather, your numeric user id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
