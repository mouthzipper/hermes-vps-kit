[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
NoNewPrivileges=yes
PrivateTmp=yes
# Home remains writable for agent workspaces, credentials and self-updates.
# User-manager filesystem namespaces require unprivileged user namespaces.
ProtectSystem=strict
ReadWritePaths=%h %t
Type=simple
ExecStart=%h/.local/bin/hermes "gateway" "run"
WorkingDirectory=%h/.hermes
Environment="PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

Environment="HERMES_HOME=%h/.hermes"
Environment="HERMES_SUPERVISED_CHILD=1"
Restart=always
RestartSec=5
RestartForceExitStatus=75
SuccessExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStop=-%h/.local/bin/hermes "--run-module" "gateway.systemd_stop_mark"
ExecStopPost=-%h/.local/bin/hermes "--run-module" "gateway.cgroup_cleanup"
TimeoutStopSec=70
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
