[Unit]
Description=Herdr headless server (session %i)
[Service]
NoNewPrivileges=yes
PrivateTmp=yes
# Home remains writable for agent workspaces, credentials and self-updates.
# User-manager filesystem namespaces require unprivileged user namespaces.
ProtectSystem=strict
ReadWritePaths=%h %t
Type=simple
Environment=PATH=%h/.local/bin:%h/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
WorkingDirectory=%h/projects
ExecStart=%h/.local/bin/herdr --session %i server
Restart=on-failure
RestartSec=5
[Install]
WantedBy=default.target
