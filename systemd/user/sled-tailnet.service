[Unit]
Description=Forward Sled to the Tailscale IP only (__TAILSCALE_IP__:8787 -> 127.0.0.1:8787)
After=sled.service

[Service]
NoNewPrivileges=yes
PrivateTmp=yes
# Home remains writable for agent workspaces, credentials and self-updates.
# User-manager filesystem namespaces require unprivileged user namespaces.
ProtectSystem=strict
ReadWritePaths=%h %t
ExecStart=/usr/bin/socat TCP-LISTEN:8787,bind=__TAILSCALE_IP__,reuseaddr,fork TCP:127.0.0.1:8787
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
